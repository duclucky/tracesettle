{
  "name": "tracesettle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run check:contract && npm run check:tests && npm run check:deployment && npm run check:frontend",
    "check:contract": "set PYTHONUTF8=1&& .venv\\Scripts\\genvm-lint.exe check contracts/tracesettle.py",
    "check:tests": ".venv\\Scripts\\python.exe -m pytest tests/direct -q",
    "check:deployment": "node --test scripts/*.test.mjs",
    "check:frontend": "cd frontend && npm test && npm run build",
    "inspect:deployment": "node scripts/inspect-deployment.mjs",
    "deploy:studionet": "node scripts/deploy-studionet.mjs"
  },
  "dependencies": {
    "genlayer-js": "^1.1.8"
  }
}
